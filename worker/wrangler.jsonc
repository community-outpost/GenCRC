{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gencrc",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "rules": [{ "type": "Text", "globs": ["**/page-client.js"], "fallthrough": false }],
  "assets": {
    "directory": "./retail",
    "binding": "RETAIL",
    "run_worker_first": true
  },
  "limits": {
    "cpu_ms": 30000
  }
}
